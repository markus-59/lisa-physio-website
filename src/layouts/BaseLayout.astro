---
import { Font } from "astro:assets";
import Sidebar from "../components/Sidebar.astro";
import { siteSubtitle, siteTitle } from "../data/site";
import "../styles/global.css";

interface Props {
  /** Page name for the browser tab. Leave out on the homepage. */
  title?: string;
  description?: string;
}

const { title, description = `${siteTitle}: ${siteSubtitle}.` } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : `${siteTitle}: ${siteSubtitle}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-bigshoulders" preload />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-atkinson" preload />
  </head>
  <body class="min-h-dvh font-sans text-[1.0625rem] leading-relaxed">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-ink px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <!-- Phones: top bar with the menu button on the left, where the sidebar opens. -->
    <header
      class="sticky top-0 z-30 flex items-center gap-3 border-b border-line bg-plaster/95 px-4 py-3 backdrop-blur md:hidden"
    >
      <button
        type="button"
        data-menu-open
        aria-controls="site-nav"
        aria-expanded="false"
        class="flex items-center gap-2 rounded-md border border-line bg-white px-3 py-1.5 font-bold"
      >
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"></path>
        </svg>
        Menu
      </button>
      <a href="/" class="font-display text-2xl leading-none font-extrabold">{siteTitle}</a>
    </header>

    <div data-menu-backdrop class="fixed inset-0 z-30 hidden bg-ink/40 md:hidden"></div>

    <!-- Tablet and up: the sidebar is always shown on the left. -->
    <aside
      id="site-nav"
      class="invisible fixed inset-y-0 left-0 z-40 w-72 -translate-x-full overflow-y-auto border-r border-line bg-plaster motion-safe:transition-[translate,visibility] motion-safe:duration-200 data-open:visible data-open:translate-x-0 md:visible md:translate-x-0"
    >
      <button
        type="button"
        data-menu-close
        class="absolute top-4 right-4 rounded-md px-2 py-1 text-sm font-bold text-muted hover:text-ink md:hidden"
      >
        Close
      </button>
      <Sidebar />
    </aside>

    <main id="main" class="md:pl-72">
      <div class="mx-auto max-w-4xl px-5 pt-10 pb-24 sm:px-8 lg:px-12 lg:pt-16">
        <slot />
      </div>
    </main>

    <script>
      const nav = document.getElementById("site-nav")!;
      const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]")!;
      const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]")!;
      const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]")!;

      function setOpen(open: boolean) {
        nav.toggleAttribute("data-open", open);
        backdrop.classList.toggle("hidden", !open);
        openButton.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("overflow-hidden", open);
        (open ? closeButton : openButton).focus();
      }

      openButton.addEventListener("click", () => setOpen(true));
      closeButton.addEventListener("click", () => setOpen(false));
      backdrop.addEventListener("click", () => setOpen(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && nav.hasAttribute("data-open")) setOpen(false);
      });
    </script>
  </body>
</html>
