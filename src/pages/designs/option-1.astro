---
// Design option 1 — "Race Day": bold, sporty, high contrast. Race-bib numbers and course-blue.
import "../../styles/global.css";
import DesignSwitch from "../../components/DesignSwitch.astro";
import { course, extras, url } from "../../data/site";

const activeIndex = 1;
const label = "text-xs font-extrabold tracking-[0.22em] uppercase";

const frameworks = [
  {
    title: "Cognitive-behavioural model of fatigue",
    what: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio praesent libero, sed cursus ante dapibus diam.",
    how: "Sed nisi. Nulla quis sem at nibh elementum imperdiet. Duis sagittis ipsum. Praesent mauris fusce nec tellus sed augue semper porta.",
    relation: "Mauris massa. Vestibulum lacinia arcu eget nulla. Class aptent taciti sociosqu ad litora torquent per conubia nostra.",
  },
  {
    title: "Central governor model",
    what: "Curabitur sodales ligula in libero. Sed dignissim lacinia nunc. Curabitur tortor pellentesque nibh aenean quam.",
    how: "In scelerisque sem at dolor. Maecenas mattis. Sed convallis tristique sem. Proin ut ligula vel nunc egestas porttitor.",
    relation: "Morbi lectus risus, iaculis vel, suscipit quis, luctus non, massa. Fusce ac turpis quis ligula lacinia aliquet.",
  },
  {
    title: "Energy envelope theory",
    what: "Mauris ipsum. Nulla metus metus, ullamcorper vel, tincidunt sed, euismod in, nibh. Quisque volutpat condimentum velit.",
    how: "Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Nam nec ante.",
    relation: "Sed lacinia, urna non tincidunt mattis, tortor neque adipiscing diam, a cursus ipsum ante quis turpis.",
  },
];

const strategies = [
  { title: "Lorem ipsum dolor", text: "Nulla facilisi. Ut fringilla. Suspendisse potenti. Nunc feugiat mi a tellus consequat imperdiet." },
  { title: "Sit amet consectetur", text: "Vestibulum sapien. Proin quam. Etiam ultrices. Suspendisse in justo eu magna luctus suscipit." },
  { title: "Adipiscing elit sed", text: "Sed lectus. Integer euismod lacus luctus magna. Quisque cursus, metus vitae pharetra auctor." },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Option 1: Race Day · The Mental Marathon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,400;0,600;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --f-head: "Anton", "Arial Narrow", sans-serif;
        --f-body: "Archivo", system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-dvh bg-[#F1F2F4] font-(family-name:--f-body) text-[1.0625rem] leading-relaxed text-[#16181D]">
    <!-- Phone menu -->
    <details class="sticky top-0 z-30 bg-[#0B2E8A] text-white md:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
        <span class="rounded-sm bg-[#FFD23F] px-2.5 py-1 text-sm font-extrabold text-[#16181D]">☰ Menu</span>
        <span class="font-(family-name:--f-head) text-xl uppercase">The Mental Marathon</span>
      </summary>
      <nav class="space-y-1 px-4 pb-4">
        {[...course, ...extras].map((item) => <a href={item.href} class="block py-1.5 font-semibold">{item.label}</a>)}
      </nav>
    </details>

    <!-- Sidebar -->
    <aside class="fixed inset-y-0 left-0 hidden w-64 flex-col gap-8 overflow-y-auto bg-[#0B2E8A] px-5 py-8 text-white md:flex">
      <a href={url("/")} class="font-(family-name:--f-head) text-4xl leading-[0.95] text-[#FFD23F] uppercase">The Mental<br />Marathon</a>
      <ol class="space-y-1">
        {
          course.map((item, i) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "flex items-center gap-3 border-l-4 px-3 py-2",
                  i === activeIndex ? "border-[#FFD23F] bg-white/10" : "border-transparent hover:bg-white/5",
                ]}
              >
                <span class="w-8 font-(family-name:--f-head) text-2xl text-[#FFD23F]">{i === 0 ? "▸" : `0${i}`}</span>
                <span>
                  <span class="block text-[0.65rem] font-extrabold tracking-[0.2em] text-white/60 uppercase">{item.eyebrow}</span>
                  <span class="block leading-snug font-semibold">{item.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <ul class="space-y-1 border-t border-dashed border-white/30 pt-6">
        {extras.map((item) => <li><a href={item.href} class="block px-3 py-1.5 text-white/85 hover:text-white hover:underline">{item.label}</a></li>)}
      </ul>
    </aside>

    <main class="md:pl-64">
      <!-- Hero with race bib -->
      <header class="bg-[#0B2E8A] text-white">
        <div class="mx-auto grid max-w-5xl items-center gap-10 px-6 py-14 md:grid-cols-[1fr_auto] md:px-12 md:py-20">
          <div>
            <h1 class="font-(family-name:--f-head) text-5xl leading-[0.95] font-normal text-[#FFD23F] uppercase md:text-7xl">
              The Mental Marathon
            </h1>
            <h2 class="mt-4 font-(family-name:--f-head) text-4xl leading-[0.95] font-normal text-white uppercase md:text-6xl">
              Module 1: Fatigue
            </h2>
          </div>
          <div aria-hidden="true" class="relative w-52 rotate-[-3deg] rounded-md bg-white px-5 pt-7 pb-5 text-center text-[#0B2E8A] shadow-2xl">
            <span class="absolute top-2 left-2 size-2.5 rounded-full bg-[#F1F2F4] ring-1 ring-black/15"></span>
            <span class="absolute top-2 right-2 size-2.5 rounded-full bg-[#F1F2F4] ring-1 ring-black/15"></span>
            <span class="absolute bottom-2 left-2 size-2.5 rounded-full bg-[#F1F2F4] ring-1 ring-black/15"></span>
            <span class="absolute right-2 bottom-2 size-2.5 rounded-full bg-[#F1F2F4] ring-1 ring-black/15"></span>
            <p class="text-[0.6rem] font-extrabold tracking-[0.3em] uppercase">Mental Marathon</p>
            <p class="font-(family-name:--f-head) text-[6.5rem] leading-none">01</p>
            <p class="-mx-5 bg-[#FFD23F] py-1 font-(family-name:--f-head) text-xl tracking-wider text-[#16181D] uppercase">Fatigue</p>
          </div>
        </div>
      </header>

      <div class="mx-auto max-w-5xl space-y-20 px-6 py-14 md:px-12">
        <!-- My rehab -->
        <section class="grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_15rem]">
          <div class="max-w-prose space-y-4">
            <p class:list={[label, "text-[#0B2E8A]"]}>My rehab</p>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
              magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
              consequat.
            </p>
            <p>
              Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
              Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
            </p>
          </div>
          <figure class="flex aspect-4/5 max-w-60 items-center justify-center border-4 border-[#16181D] bg-white text-sm font-semibold text-[#16181D]/60 shadow-[10px_10px_0_#FFD23F]">
            Photo of Lisa's rehab
          </figure>
        </section>

        <!-- Frameworks -->
        <section>
          <h4 class="font-(family-name:--f-head) text-4xl font-normal uppercase md:text-5xl">Psychological Frameworks</h4>
          <p class="text-lg text-[#16181D]/70 italic">underpinning fatigue</p>
          <div class="mt-8 border-t-4 border-[#16181D]">
            {
              frameworks.map((f, i) => (
                <details class="framework group border-b-2 border-[#16181D]/15">
                  <summary class="flex cursor-pointer list-none items-center gap-5 py-5 [&::-webkit-details-marker]:hidden">
                    <span class="flex size-12 shrink-0 items-center justify-center bg-[#FFD23F] font-(family-name:--f-head) text-2xl">
                      0{i + 1}
                    </span>
                    <span class="flex-1 font-(family-name:--f-head) text-2xl leading-tight uppercase md:text-3xl">{f.title}</span>
                    <span
                      aria-hidden="true"
                      class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-[#16181D] text-2xl transition-transform group-open:rotate-45"
                    >
                      +
                    </span>
                  </summary>
                  <div class="grid gap-6 pb-8 md:grid-cols-3 md:pl-17">
                    {[
                      ["What it is", f.what],
                      ["How it works", f.how],
                      ["Relation to this context", f.relation],
                    ].map(([k, v]) => (
                      <div class="border-t-4 border-[#0B2E8A] pt-3">
                        <p class:list={[label, "text-[#0B2E8A]"]}>{k}</p>
                        <p class="mt-2">{v}</p>
                      </div>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </section>

        <!-- Strategies -->
        <section>
          <h4 class="font-(family-name:--f-head) text-4xl font-normal uppercase md:text-5xl">PIPT Strategies</h4>
          <ol class="mt-8 grid gap-4 md:grid-cols-3">
            {
              strategies.map((s, i) => (
                <li class="bg-[#0B2E8A] p-6 text-white">
                  <p class="font-(family-name:--f-head) text-5xl text-[#FFD23F]">{i + 1}</p>
                  <p class="mt-3 font-extrabold tracking-wide uppercase">{s.title}</p>
                  <p class="mt-2 text-white/80">{s.text}</p>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </main>

    <DesignSwitch current="1" />
  </body>
</html>
