---
// Design option 4 — "Treatment Plan": the page reads like a physio's clinical notes. SOAP sections, resistance-band
// colours for the modules, and a goniometer that measures how far through the course you are.
import "../../styles/global.css";
import DesignSwitch from "../../components/DesignSwitch.astro";
import { course, extras, url } from "../../data/site";

const activeIndex = 1;
const moduleCount = course.length - 1;

// Resistance-band colours, light to firm: Home first, then each module in order.
const bands = ["#D8C3A0", "#F2C230", "#D2433A", "#2E8B57"];

// Goniometer: a half dial from 0° (left) to 180° (right), pivoting at (120, 120) with radius 100.
const angle = Math.round((activeIndex / moduleCount) * 180);
const point = (deg: number, r: number) => {
  const rad = (deg * Math.PI) / 180;
  return { x: +(120 - r * Math.cos(rad)).toFixed(2), y: +(120 - r * Math.sin(rad)).toFixed(2) };
};
const ticks = Array.from({ length: 37 }, (_, i) => {
  const deg = i * 5;
  const length = deg % 30 === 0 ? 14 : deg % 10 === 0 ? 9 : 5;
  return { from: point(deg, 100), to: point(deg, 100 - length), major: deg % 30 === 0 };
});
const scale = [0, 30, 60, 90, 120, 150, 180].map((deg) => {
  const p = point(deg, 76);
  return { deg, x: p.x, y: deg % 180 === 0 ? p.y - 8 : p.y };
});
const reached = point(angle, 100);

const frameworks = [
  {
    title: "Cognitive-behavioural model of fatigue",
    what: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio praesent libero, sed cursus ante dapibus diam.",
    how: "Sed nisi. Nulla quis sem at nibh elementum imperdiet. Duis sagittis ipsum. Praesent mauris fusce nec tellus sed augue semper porta.",
    relation: "Mauris massa. Vestibulum lacinia arcu eget nulla. Class aptent taciti sociosqu ad litora torquent per conubia nostra.",
  },
  {
    title: "Central governor model",
    what: "Curabitur sodales ligula in libero. Sed dignissim lacinia nunc. Curabitur tortor pellentesque nibh aenean quam.",
    how: "In scelerisque sem at dolor. Maecenas mattis. Sed convallis tristique sem. Proin ut ligula vel nunc egestas porttitor.",
    relation: "Morbi lectus risus, iaculis vel, suscipit quis, luctus non, massa. Fusce ac turpis quis ligula lacinia aliquet.",
  },
  {
    title: "Energy envelope theory",
    what: "Mauris ipsum. Nulla metus metus, ullamcorper vel, tincidunt sed, euismod in, nibh. Quisque volutpat condimentum velit.",
    how: "Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Nam nec ante.",
    relation: "Sed lacinia, urna non tincidunt mattis, tortor neque adipiscing diam, a cursus ipsum ante quis turpis.",
  },
];

const strategies = [
  { title: "Lorem ipsum dolor", text: "Nulla facilisi. Ut fringilla. Suspendisse potenti. Nunc feugiat mi a tellus consequat imperdiet.", dose: "Daily · 5 min" },
  { title: "Sit amet consectetur", text: "Vestibulum sapien. Proin quam. Etiam ultrices. Suspendisse in justo eu magna luctus suscipit.", dose: "3× a week" },
  { title: "Adipiscing elit sed", text: "Sed lectus. Integer euismod lacus luctus magna. Quisque cursus, metus vitae pharetra auctor.", dose: "When needed" },
];

const mono = "font-(family-name:--f-mono)";
const head = "font-(family-name:--f-head) tracking-normal";
const gutter =
  "flex items-baseline gap-3 border-b border-[#C9D8D6] bg-[#F3F6F4] px-6 py-3 md:flex-col md:gap-1 md:border-r md:border-b-0 md:px-4 md:py-7";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Option 4: Treatment Plan · The Mental Marathon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Public+Sans:ital,wght@0,400;0,600;1,400&family=Spline+Sans+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --f-head: "Barlow Condensed", "Arial Narrow", sans-serif;
        --f-body: "Public Sans", system-ui, sans-serif;
        --f-mono: "Spline Sans Mono", ui-monospace, monospace;
      }

      /* The goniometer's moving arm swings out to the reading once, on load. */
      .gonio-arm {
        transform-box: view-box;
        transform-origin: 120px 120px;
        rotate: var(--angle);
      }
      @media (prefers-reduced-motion: no-preference) {
        .gonio-arm {
          animation: gonio-swing 1.4s cubic-bezier(0.3, 1.35, 0.5, 1) 0.3s backwards;
        }
      }
      @keyframes gonio-swing {
        from {
          rotate: 0deg;
        }
      }
    </style>
  </head>
  <body class="min-h-dvh bg-[#F3F6F4] font-(family-name:--f-body) text-[1.0625rem] leading-relaxed text-[#132A2E]">
    <!-- Phone menu -->
    <details class="sticky top-0 z-30 bg-[#0F4C52] text-white md:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
        <span class="rounded-md bg-white px-2.5 py-1 text-sm font-semibold text-[#0F4C52]">☰ Menu</span>
        <span class:list={[head, "text-xl font-bold"]}>The Mental Marathon</span>
      </summary>
      <nav class="space-y-1 px-4 pb-4">
        {[...course, ...extras].map((item) => <a href={item.href} class="block py-1.5">{item.label}</a>)}
      </nav>
    </details>

    <!-- Sidebar: each stop wears the colour of a resistance band, getting firmer as the course goes on. -->
    <aside class="fixed inset-y-0 left-0 hidden w-64 flex-col gap-8 overflow-y-auto bg-[#0F4C52] px-5 py-8 text-white md:flex">
      <a href={url("/")} class:list={[head, "text-[2rem] leading-[0.95] font-bold"]}>The Mental Marathon</a>
      <div>
        <ol class="space-y-1">
          {
            course.map((item, i) => (
              <li>
                <a
                  href={item.href}
                  aria-current={i === activeIndex ? "page" : undefined}
                  class:list={["group flex items-center gap-3 rounded-md px-2 py-2", i === activeIndex ? "bg-white/10" : "hover:bg-white/5"]}
                >
                  <span aria-hidden="true" class="flex w-10 shrink-0">
                    <span
                      class:list={[
                        "h-2.5 rounded-full motion-safe:transition-[width] motion-safe:duration-300",
                        i === activeIndex ? "w-10" : "w-6 group-hover:w-9",
                      ]}
                      style={`background:${bands[i]}`}
                    />
                  </span>
                  <span>
                    <span class:list={[mono, "block text-[0.7rem] text-white/60"]}>{item.eyebrow}</span>
                    <span class="block leading-snug font-semibold">{item.label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class:list={[mono, "mt-4 flex items-center gap-2 px-2 text-[0.7rem] text-white/60"]}>
          <span aria-hidden="true" class="flex gap-0.5">
            {bands.map((colour) => <span class="h-1.5 w-3 rounded-full" style={`background:${colour}`} />)}
          </span>
          Bands get firmer as you go
        </p>
      </div>
      <ul class="space-y-1 border-t border-white/15 pt-5">
        {extras.map((item) => <li><a href={item.href} class="block px-2 py-1.5 text-white/80 hover:text-white hover:underline">{item.label}</a></li>)}
      </ul>
    </aside>

    <main class="px-4 py-8 md:py-12 md:pr-8 md:pl-72">
      <div class="mx-auto max-w-4xl">
        <!-- Header with the goniometer -->
        <header class="grid items-end gap-8 border-b-2 border-[#132A2E] pb-8 md:grid-cols-[minmax(0,1fr)_15rem]">
          <div class="text-center md:text-left">
            <p class:list={[mono, "text-sm text-[#0F4C52]"]}>Treatment plan · Module {activeIndex} of {moduleCount}</p>
            <h1 class:list={[head, "mt-3 text-5xl font-bold md:text-6xl"]}>The Mental Marathon</h1>
            <h2 class:list={[head, "mt-1 text-[2.5rem] font-semibold text-[#0F4C52] md:text-5xl"]}>Module 1: Fatigue</h2>
            <span aria-hidden="true" class="mx-auto mt-4 block h-2.5 w-24 rounded-full md:mx-0" style={`background:${bands[activeIndex]}`}></span>
          </div>

          <figure class="mx-auto w-60 md:mx-0" role="img" aria-label={`Progress: module ${activeIndex} of ${moduleCount}`}>
            <svg viewBox="0 0 240 140" class="w-full overflow-visible" aria-hidden="true">
              <path d="M 20 120 A 100 100 0 0 1 220 120 Z" fill="#FFFFFF" stroke="#C9D8D6" stroke-width="1.5" />
              <path d={`M 120 120 L 20 120 A 100 100 0 0 1 ${reached.x} ${reached.y} Z`} fill={bands[activeIndex]} fill-opacity="0.45" />
              {ticks.map((t) => <line x1={t.from.x} y1={t.from.y} x2={t.to.x} y2={t.to.y} stroke="#132A2E" stroke-width={t.major ? 1.6 : 0.8} />)}
              {
                scale.map((s) => (
                  <text x={s.x} y={s.y} text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#56696C" font-family="var(--f-mono)">
                    {s.deg}
                  </text>
                ))
              }
              <!-- Stationary arm, along 0° -->
              <rect x="-6" y="120" width="132" height="11" rx="5.5" fill="#0F4C52" fill-opacity="0.9" />
              <!-- Moving arm: drawn at 0°, rotated to the reading -->
              <g class="gonio-arm" style={`--angle:${angle}deg`}>
                <rect x="-2" y="114.5" width="128" height="11" rx="5.5" fill="#0A3438" fill-opacity="0.85" />
                <line x1="4" y1="120" x2="112" y2="120" stroke="#FFFFFF" stroke-opacity="0.7" stroke-width="1" />
              </g>
              <circle cx="120" cy="120" r="7.5" fill="#132A2E" />
              <circle cx="120" cy="120" r="2.5" fill="#F3F6F4" />
            </svg>
            <figcaption class="mt-3 flex items-baseline justify-center gap-2 md:justify-start">
              <span class:list={[mono, "text-3xl font-medium"]}>{angle}°</span>
              <span class="text-sm text-[#56696C]">of the course covered</span>
            </figcaption>
          </figure>
        </header>

        <!-- Clinical notes sheet: Subjective / Objective, Assessment, Plan -->
        <div class="mt-10 overflow-hidden rounded-md border border-[#C9D8D6] bg-white shadow-[0_1px_0_#C9D8D6]">
          <section class="grid border-b border-[#C9D8D6] md:grid-cols-[5.5rem_minmax(0,1fr)]">
            <div class={gutter}>
              <span class:list={[head, "text-4xl leading-none font-bold text-[#0F4C52]"]}>S</span>
              <span class:list={[mono, "text-xs text-[#56696C]"]}>Subjective</span>
            </div>
            <div class="grid gap-8 p-6 md:grid-cols-[minmax(0,1fr)_13rem] md:p-8">
              <div class="space-y-4">
                <p class:list={[mono, "text-sm text-[#0F4C52]"]}>My rehab</p>
                <p>
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et
                  dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex
                  ea commodo consequat.
                </p>
                <p>
                  Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
                  Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est
                  laborum.
                </p>
              </div>
              <figure class="relative mx-auto w-full max-w-52 pt-3">
                <span class:list={[mono, "absolute top-0 left-3 z-10 rounded-sm bg-[#0F4C52] px-2 py-0.5 text-xs text-white"]}>
                  O · Objective
                </span>
                <div class="flex aspect-4/5 flex-col items-center justify-center gap-3 rounded-sm border border-[#C9D8D6] bg-[#F3F6F4] p-6 text-center text-sm text-[#56696C]">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-9" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="12" cy="12" r="3.5" />
                    <path d="M8 5l1.5-2h5L16 5" stroke-linejoin="round" />
                  </svg>
                  Photo of Lisa's rehab
                </div>
              </figure>
            </div>
          </section>

          <section class="grid border-b border-[#C9D8D6] md:grid-cols-[5.5rem_minmax(0,1fr)]">
            <div class={gutter}>
              <span class:list={[head, "text-4xl leading-none font-bold text-[#0F4C52]"]}>A</span>
              <span class:list={[mono, "text-xs text-[#56696C]"]}>Assessment</span>
            </div>
            <div class="p-6 md:p-8">
              <h4 class:list={[head, "text-[1.75rem] font-bold md:text-[2rem]"]}>Psychological Frameworks</h4>
              <p class="text-[#56696C] italic">underpinning fatigue</p>
              <div class="mt-6 divide-y divide-[#C9D8D6] border-y border-[#C9D8D6]">
                {
                  frameworks.map((f) => (
                    <details class="framework group">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
                        <span class:list={[head, "text-2xl leading-tight font-semibold group-hover:text-[#0F4C52]"]}>{f.title}</span>
                        <span
                          aria-hidden="true"
                          class="flex size-8 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#0F4C52] text-xl leading-none text-[#0F4C52] transition-transform group-open:rotate-45"
                        >
                          +
                        </span>
                      </summary>
                      <dl class="grid gap-5 pb-6 md:grid-cols-3">
                        {[
                          ["What it is", f.what],
                          ["How it works", f.how],
                          ["Relation to this context", f.relation],
                        ].map(([k, v]) => (
                          <div class="border-t-2 border-[#0F4C52] pt-2">
                            <dt class:list={[mono, "text-xs text-[#0F4C52]"]}>{k}</dt>
                            <dd class="mt-1.5 text-[0.98rem]">{v}</dd>
                          </div>
                        ))}
                      </dl>
                    </details>
                  ))
                }
              </div>
            </div>
          </section>

          <section class="grid md:grid-cols-[5.5rem_minmax(0,1fr)]">
            <div class={gutter}>
              <span class:list={[head, "text-4xl leading-none font-bold text-[#0F4C52]"]}>P</span>
              <span class:list={[mono, "text-xs text-[#56696C]"]}>Plan</span>
            </div>
            <div class="p-6 md:p-8">
              <h4 class:list={[head, "text-[1.75rem] font-bold md:text-[2rem]"]}>PIPT Strategies</h4>
              <div class:list={[mono, "mt-6 hidden grid-cols-[12rem_minmax(0,1fr)_7.5rem] gap-6 pb-2 text-xs text-[#56696C] md:grid"]} aria-hidden="true">
                <span>Strategy</span><span>What to do</span><span>Dose</span>
              </div>
              <ol class="mt-4 md:mt-0">
                {
                  strategies.map((s) => (
                    <li class="grid gap-1 border-t border-[#C9D8D6] py-4 md:grid-cols-[12rem_minmax(0,1fr)_7.5rem] md:gap-6">
                      <p class="font-semibold">{s.title}</p>
                      <p class="text-[#56696C]">{s.text}</p>
                      <p>
                        <span class:list={[mono, "inline-block rounded-sm bg-[#F3F6F4] px-2 py-0.5 text-xs text-[#0F4C52] ring-1 ring-[#C9D8D6]"]}>
                          {s.dose}
                        </span>
                      </p>
                    </li>
                  ))
                }
              </ol>
            </div>
          </section>
        </div>
        <div class="h-20"></div>
      </div>
    </main>

    <DesignSwitch current="4" />
  </body>
</html>
