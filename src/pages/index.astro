---
import BaseLayout from "../layouts/BaseLayout.astro";
import Placeholder from "../components/Placeholder.astro";
import RehabPhoto from "../components/RehabPhoto.astro";
import { course, scopeOfPractice, siteSubtitle } from "../data/site";

const modules = course.slice(1);
const eyebrow = "text-xs font-bold tracking-[0.18em] text-tape uppercase";
---

<BaseLayout>
  <h1 class="mb-14 lg:mb-20">
    <span class="block font-display text-6xl leading-[0.88] font-black tracking-tight uppercase sm:text-7xl lg:text-8xl">
      The Mental Marathon<span class="text-pink">:</span>
    </span>
    <span class="mt-5 block max-w-2xl font-serif text-2xl leading-snug font-normal text-ink/85 italic sm:text-3xl">
      {siteSubtitle}
    </span>
  </h1>

  <div class="max-w-prose space-y-12">
    <section class="space-y-3">
      <h2 class={eyebrow}>What this is</h2>
      <Placeholder>Paragraph: what this site is, and who it's for.</Placeholder>
    </section>

    <section class="space-y-3">
      <h2 class={eyebrow}>Why it matters</h2>
      <Placeholder>Paragraph: why the psychology of recovery matters.</Placeholder>
    </section>
  </div>

  <section class="mt-12 grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
    <div class="max-w-prose space-y-3">
      <h2 class={eyebrow}>My rehab</h2>
      <Placeholder>Paragraph: your own rehab story, in brief.</Placeholder>
    </div>
    <RehabPhoto class="max-w-60 md:max-w-none" />
  </section>

  <section class="mt-20" aria-labelledby="modules-heading">
    <h2 id="modules-heading" class={eyebrow}>The modules</h2>

    <!-- Same route as the sidebar: one stop per module. -->
    <ol class="relative mt-6 max-w-2xl">
      {
        modules.map((item, i) => (
          <li class="relative pb-5 pl-16">
            {i < modules.length - 1 && (
              <span aria-hidden="true" class="absolute top-12 bottom-0 left-[21px] border-l-2 border-dashed border-tape/35" />
            )}
            <span
              aria-hidden="true"
              class="absolute top-3 left-0 flex size-11 items-center justify-center rounded-full bg-tape font-display text-2xl font-black text-white"
            >
              {i + 1}
            </span>
            <a
              href={item.href}
              class="group flex items-center justify-between gap-4 rounded-xl border border-line bg-white px-5 py-4 shadow-sm transition-colors hover:border-tape"
            >
              <span>
                <span class="block text-xs font-bold tracking-[0.16em] text-muted uppercase">{item.eyebrow}</span>
                <span class="block font-display text-3xl leading-tight font-extrabold uppercase group-hover:text-tape-deep">
                  {item.label}
                </span>
              </span>
              <span aria-hidden="true" class="text-2xl text-tape transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))
      }
    </ol>

    <a
      href={scopeOfPractice.href}
      class="group mt-3 flex max-w-2xl items-center justify-between gap-4 rounded-xl border border-line bg-ink px-5 py-4 text-white transition-colors hover:bg-tape-deep"
    >
      <span>
        <span class="block text-xs font-bold tracking-[0.16em] text-white/70 uppercase">Guide</span>
        <span class="block font-display text-3xl leading-tight font-extrabold uppercase">{scopeOfPractice.label}</span>
      </span>
      <span aria-hidden="true" class="text-2xl transition-transform group-hover:translate-x-1">→</span>
    </a>
  </section>
</BaseLayout>
