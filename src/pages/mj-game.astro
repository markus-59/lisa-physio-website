  // ---------- Obstacle art, drawn once into small canvases ----------

  type Put = (colour: string, x: number, y: number, w?: number, h?: number) => void;

  function paint(width: number, height: number, draw: (put: Put) => void) {
    const c = document.createElement("canvas");
    c.width = width;
    c.height = height;
    const g = c.getContext("2d")!;
    draw((colour, x, y, w = 1, h = 1) => {
      g.fillStyle = colour;
      g.fillRect(x, y, w, h);
    });
    return c;
  }

  const PALETTE: Record<string, string> = {
    k: INK, w: WHITE, b: TAPE, o: "#f08a2c", r: "#d64545", i: IRON, h: "#8692a0", c: "#a8713f", g: "#9aa5b1",
    s: "#ccd3da",
  };

  /** Pixel art from rows of palette letters; "." is see-through. */
  function pixels(rows: string[]) {
    return paint(rows[0].length, rows.length, (put) =>
      rows.forEach((row, y) => [...row].forEach((ch, x) => PALETTE[ch] && put(PALETTE[ch], x, y))),
    );
  }

  /** A stack of 3 to 5 textbooks, freshly shuffled each time. */
  function books(): Art {
    const count = 3 + Math.floor(Math.random() * 3);
    const covers = [TAPE, PINK, GREEN, GOLD, TAPE_DEEP];
    const h = count * 6 + 1;
    let left = 30;
    let right = 0;
    const img = paint(30, h, (put) => {
      for (let i = 0; i < count; i++) {
        const w = 22 + Math.floor(Math.random() * 8);
        const x = Math.floor(Math.random() * (31 - w));
        const y = h - 7 - i * 6;
        left = Math.min(left, x);
        right = Math.max(right, x + w);
        put(INK, x, y, w, 7);
        put(covers[(i + count) % covers.length], x + 1, y + 1, w - 2, 5);
        if (Math.random() < 0.5) put(PAGE, x + 1, y + 2, w - 3, 3); // page edges
        else put(GOLD, x + 3, y + 3, w - 10, 1); // title on the spine
      }
    });
    return { img: [img], box: { x: left + 1, y: 1, w: right - left - 2, h: h - 1 } };
  }

