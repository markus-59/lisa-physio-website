  // Sports kit, scaled down from the sport/ pack into mj-sports.png: [x, y, w, h] for each frame.
  // Balls have four quarter turns so they can roll; things in the air flip as they spin.
  const SPORTS: Record<string, number[][]> = {
    basketball: [[1, 1, 16, 16], [18, 1, 16, 16], [35, 1, 16, 16], [52, 1, 16, 16]],
    football: [[69, 1, 15, 15], [85, 1, 15, 15], [101, 1, 15, 15], [117, 1, 15, 15]],
