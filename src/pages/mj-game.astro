---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../data/site";

// Michael's frames were cut from MJ/Mj2.png, the sports kit from sport/ and the sounds from the MJ/ videos.
// All of them live in public/mj-game/.
const sprites = url("/mj-game/mj-sprites.png");
const sportsKit = url("/mj-game/mj-sports.png");
const jumpSound = url("/mj-game/mj-hehe.mp3");
const crashSound = url("/mj-game/mj-ow.mp3");

/** The Masters, in the order Michael studies it. One module per 150 points. */
const modules = [
  "Anatomy",
  "Physiology",
  "Biomechanics",
  "Musculoskeletal rehab",
  "Neuro rehab",
  "Cardiorespiratory",
  "Clinical placement",
  "Dissertation",
];
---

<BaseLayout title="Smooth Graduate" description="A jumping game: help Michael Jackson earn his Masters in Physiotherapy.">
  <h1>Smooth Graduate</h1>
  <p class="mt-4 max-w-prose">
    Michael Jackson is studying for a Masters in Physiotherapy. Help him jump over the obstacles in his way, pass
    all {modules.length} modules and graduate. Each module brings its own obstacles, from textbooks and sports kit to
    physio gym gear and aged-care equipment.
  </p>

  <section
    data-game
    data-sprites={sprites}
    data-sports={sportsKit}
    data-jump-sound={jumpSound}
    data-crash-sound={crashSound}
    data-modules={JSON.stringify(modules)}
    tabindex="-1"
    aria-label="Smooth Graduate game"
    class="mt-8 overflow-hidden rounded-xl border border-line bg-white shadow-sm outline-none"
  >
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 px-4 pt-3 pb-2 text-sm">
      <p data-module class="mr-auto font-bold">Module 1 of {modules.length}: {modules[0]}</p>
      <p class="tabular-nums">Score <span data-score class="font-bold">0</span></p>
      <p class="text-muted tabular-nums">Best <span data-best>0</span></p>
      <button
        type="button"
        data-mute
        class="rounded-full border border-line px-3 py-1 font-bold transition-colors hover:border-tape"
      >
        Sound: on
      </button>
    </div>

    <ol class="grid grid-cols-8 gap-1 px-4 pb-3" aria-label="Module progress">
      {
        modules.map((name) => (
          <li title={name} class="h-1.5 overflow-hidden rounded-full bg-line">
            <span data-segment class="block h-full w-0 bg-tape" />
            <span class="sr-only">{name}</span>
          </li>
        ))
      }
    </ol>

    <div data-stage class="relative touch-none select-none" style="-webkit-tap-highlight-color: transparent">
      <canvas
        class="block w-full"
        style="aspect-ratio: 640 / 200"
        role="img"
        aria-label="Michael Jackson walks to the right past study obstacles"></canvas>

      <p
        data-banner
        aria-live="polite"
        class="pointer-events-none absolute top-3 left-1/2 max-w-[90%] -translate-x-1/2 rounded-full bg-white/95 px-4 py-1.5 text-center text-sm font-bold text-ink opacity-0 shadow-sm motion-safe:transition-opacity motion-safe:duration-300"
      >
      </p>

      <div data-overlay class="absolute inset-0 flex items-center justify-center bg-ink/25 p-3">
        <div aria-live="polite" class="max-w-sm rounded-xl bg-white px-5 py-3 text-center shadow-lg sm:px-6 sm:py-5">
          <h2 data-overlay-title class="text-2xl sm:text-3xl">Ready to study?</h2>
          <p data-overlay-text class="mt-1 text-xs text-muted sm:text-sm">
            Pass all {modules.length} modules to earn the Masters.
          </p>
          <button
            type="button"
            data-overlay-button
            class="mt-3 rounded-full bg-tape px-5 py-1.5 font-bold text-white transition-colors hover:bg-tape-deep sm:py-2"
          >
            Start
          </button>
        </div>
      </div>
    </div>
  </section>

  <noscript><p class="mt-4 font-bold">The game needs JavaScript turned on.</p></noscript>

  <ul class="mt-4 space-y-1 text-sm text-muted">
    <li><b class="text-ink">Jump:</b> Space, up arrow or tap the game. Hold for a higher jump.</li>
    <li><b class="text-ink">Drop faster:</b> down arrow.</li>
    <li><b class="text-ink">Pause:</b> P. <b class="text-ink">Sound on or off:</b> M.</li>
  </ul>
</BaseLayout>

<script>
  type Rect = { x: number; y: number; w: number; h: number };
  /** A frame in mj-sprites.png, with the centre and top of Michael's hat inside it. */
  type Frame = Rect & { hx: number; hy: number };
  /** Obstacle pictures: several images make an animation. `box` is the part that hurts. */
  type Art = { img: HTMLCanvasElement[]; box: Rect };
  /** `roll` is how much faster than the ground a ball rolls at Michael; `ready` is false while its picture loads. */
  type Kind = {
    name: string;
    minGap: number;
    maxGroup: number;
    fly?: boolean;
    roll?: number;
    art: () => Art;
    ready?: () => boolean;
  };
  type Obstacle = { kind: Kind; art: Art; group: number; x: number; y: number; w: number; gap: number; drift: number; clock: number };
  type Bit = { x: number; y: number; vx: number; vy: number; colour: string; life: number };
  type Theme = { skyTop: number[]; skyBottom: number[]; far: number[]; window: number[]; ground: number[]; line: number[]; night: number };

